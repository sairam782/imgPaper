# Required to analyse real papers. Without it the app still runs and serves
# the bundled demo digest, so the whole interface stays explorable.
ANTHROPIC_API_KEY=

# The model that writes the digest. Quality here is what the product is.
PAPERPRISM_MODEL=claude-sonnet-5

# The cheaper model used to condense long papers section by section before
# the digest pass.
PAPERPRISM_CONDENSE_MODEL=claude-haiku-4-5-20251001

# Papers whose assembled text is longer than this (in characters) get the
# condensation pass instead of being sent whole.
PAPERPRISM_CONDENSE_THRESHOLD=90000

# Hard ceiling on what is sent to the model, after condensing.
PAPERPRISM_MAX_CHARS=400000

# Largest PDF accepted by the upload endpoint, in bytes.
PAPERPRISM_MAX_UPLOAD_BYTES=26214400

# Where digests are cached. Delete this directory to force re-analysis.
# PAPERPRISM_CACHE_DIR=.cache/digests
